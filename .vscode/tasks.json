{
    "version": "2.0.0",
    "inputs": [
        {
        "id": "adminPassword",
        "type": "promptString",
        "description": "Enter admin password:",
        "password": true  // Masks input with asterisks (*)
        }
    ],
    "tasks": [
        { "label": "create admin password",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/set-kubernetes-secret.ps1",
                "--Command", "set"
            ],
            "options": {
                "env": {
                    "SECRET_NAME": "admin-password",
                    "SECRET_NAMESPACE": "default",
                    "SECRET_KEY_NAME": "password",
                    "SECRET_VALUE": "${input:adminPassword}"
                }
            },
            "group": "test",
            "problemMatcher": []
        },
        { "label": "del admin password",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/set-kubernetes-secret.ps1",
                "--Command", "del"
            ],
            "options": {
                "env": {
                    "SECRET_NAME": "admin-password",
                    "SECRET_NAMESPACE": "default",
                    "SECRET_KEY_NAME": "password",
                }
            },
            "group": "test",
            "problemMatcher": []
        },
        { "label": "All - Stop",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/stop-all.ps1"
            ],
            "group": "test",
            "problemMatcher": []
        },
        { "label": "interface-jenkins-updates-downloader - Install",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/deploy-and-tail.ps1",
                "-ReleaseName", "interface-jenkins-updates-downloader",
                "-ChartPath", "./interfaces/jenkins-updates-downloader/helm",
                "-ValuesFile", "./interfaces/jenkins-updates-downloader/helm/values.yaml",
                "-AppLabel", "interface-jenkins-updates-downloader"
            ],
            "group": "test",
            "problemMatcher": []
        },
        { "label": "interface-jenkins-updates-downloader - Uninstall",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/Uninstall-Service.ps1",
                "-ServiceName", "interface-jenkins-updates-downloader"
            ],
            "group": "test",
            "problemMatcher": []
        },
        { "label": "interface-jenkins-internal-linux - Install",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/deploy-and-tail.ps1",
                "-ReleaseName", "interface-jenkins-internal-linux",
                "-ChartPath", "./interfaces/jenkins-internal-linux/helm",
                "-ValuesFile", "./interfaces/jenkins-internal-linux/helm/values.yaml",
                "-AppLabel", "interface-jenkins-internal-linux"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        },
        { "label": "interface-jenkins-internal-linux - Uninstall",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/Uninstall-Service.ps1",
                "-ServiceName", "interface-jenkins-internal-linux"
            ],
            "group": "test",
            "problemMatcher": []
        },
        { "label": "internal-linux - Build Docker Image",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/build-docker.ps1",
                "-dockerfilePath", "./internal-linux/docker",
                "-imageTag", "internal-linux",
                "-NoCache"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        { "label": "internal-linux - Deploy and Tail Logs",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/deploy-and-tail.ps1",
                "-ReleaseName", "internal-linux",
                "-ChartPath", "./internal-linux/helm",
                "-ValuesFile", "./internal-linux/helm/values.yaml,./interfaces/jenkins-internal-linux/helm/values.yaml",
                "-AppLabel", "internal-linux"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        },
        { "label": "internal-linux - uninstall",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/Uninstall-Service.ps1",
                "-ServiceName", "internal-linux"
            ],
            "group": "test",
            "problemMatcher": []
        },
        { "label": "Jenkins - Build Docker Image",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/build-docker.ps1",
                "-dockerfilePath", "./jenkins-controller/docker",
                "-imageTag", "jenkins-controller",
                "-NoCache"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        { "label": "Jenkins - Deploy and Tail Logs",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/deploy-and-tail.ps1",
                "-ReleaseName", "jenkins-controller",
                "-ChartPath", "./jenkins-controller/helm",
                "-ValuesFile", "./jenkins-controller/helm/values.yaml,./interfaces/jenkins-internal-linux/helm/values.yaml,./interfaces/jenkins-updates-downloader/helm/values.yaml",
                "-AppLabel", "jenkins-controller"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        },
        { "label": "Jenkins - Open Pod Shells",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/open-pod-shells.ps1",
                "-Prefix",
                "jenkins-controller"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        },
        { "label": "Jenkins - Uninstall",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/Uninstall-Service.ps1",
                "-ServiceName", "jenkins-controller"
            ],
            "group": "test",
            "problemMatcher": []
        },
        { "label": "Nexus - Build Docker Image",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/build-docker.ps1",
                "-envFilePath", "./nexus-repo/docker/.env",
                "-dockerfilePath", "./nexus-repo/docker",
                "-imageTag", "nexus-repo"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        { "label": "Nexus - Deploy and Tail Logs",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/deploy-and-tail.ps1",
                "-ReleaseName", "nexus-repo",
                "-ChartPath", "./nexus-repo/helm",
                "-ValuesFile", "./nexus-repo/helm/values.yaml",
                "-AppLabel", "nexus",
                "-LogFilePath", "/nexus-data/init_nexus.log"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        },
        { "label": "Nexus - Stop Repository",
            "dependsOn": [],
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/Uninstall-Service.ps1",
                "-ServiceName", "nexus-repo"
            ],
            "group": "test",
            "problemMatcher": []
        },
        { "label": "Updates Downloader - Build Docker Image",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/build-docker.ps1",
                "-dockerfilePath", "./updates-downloader/docker",
                "-imageTag", "updates-downloader",
                "-NoCache"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        { "label": "Updates Downloader - Deploy and Tail Logs",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/deploy-and-tail.ps1",
                "-ReleaseName", "updates-downloader",
                "-ChartPath", "./updates-downloader/helm",
                "-ValuesFile", "./updates-downloader/helm/values.yaml,./interfaces/jenkins-updates-downloader/helm/values.yaml",
                "-AppLabel", "updates-downloader"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        },
        { "label": "Updates Downloader - Uninstall",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                ".vscode/Uninstall-Service.ps1",
                "-ServiceName", "updates-downloader"
            ],
            "group": "test",
            "problemMatcher": []
        },
        { "label": "Create SSH Secret Docker - Build Docker Image",
            "type": "shell",
            "command": "docker",
            "args": [
                "build",
                "-t",
                "create-ssh-secret",
                "./utils/create-ssh-secret-docker",
                "--no-cache"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}