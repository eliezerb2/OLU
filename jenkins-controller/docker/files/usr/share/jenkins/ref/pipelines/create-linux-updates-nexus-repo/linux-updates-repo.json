{
  "name": "linux-updates",
  "online": true,
  "format": "yum",
  "type": "hosted",
  "storage": {
    "blobStoreName": "default",
    "strictContentTypeValidation": true,
    "writePolicy": "ALLOW"
  },
  "cleanup": {
    "policyNames": []
  },
  "yum": {
    "repodataDepth": 0,
    "deployPolicy": "STRICT"
  }
}